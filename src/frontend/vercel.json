{
  "rewrites": [
    {
      "source": "/rss/:path*",
      "destination": "https://api.riigivaade.me/rss/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.riigivaade.me/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/otsing",
      "destination": "/index.html"
    },
    {
      "source": "/kohalolek",
      "destination": "/index.html"
    },
    {
      "source": "/haaletused",
      "destination": "/index.html"
    },
    {
      "source": "/andmed",
      "destination": "/index.html"
    },
    {
      "source": "/(haaletus|istung|saadik|kone|eelnou)/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.riigikogu.ee; connect-src 'self' https://api.riigivaade.me; frame-src https://www.youtube-nocookie.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
